{
  "manifest_version": 3,
  "name": "Lattice Reference Saver",
  "short_name": "Lattice",
  "description": "Save academic references and PDFs from the current page to Lattice.",
  "version": "2.4",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Save to Lattice",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "19": "icons/19.png",
      "38": "icons/38.png",
      "48": "icons/48.png"
    }
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "icons": {
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
