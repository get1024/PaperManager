{
  "manifest_version": 3,
  "name": "PaperManager Connector",
  "version": "1.0.0",
  "description": "Review academic metadata and save it to the local PaperManager library.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "action": {"default_title": "Save to PaperManager", "default_popup": "popup.html"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
